// all.jsonc - every module vms-fastfetch supports on OpenVMS.
// Use: fastfetch -c all
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "cluster",
        "packages",
        "shell",
        "terminal",
        "terminalsize",
        "cpu",
        "cpuusage",
        "loadavg",
        "memory",
        "swap",
        "disk",
        "localip",
        "dns",
        "queues",
        "locale",
        "processes",
        "users",
        "datetime",
        "version",
        "break",
        "colors"
    ]
}
