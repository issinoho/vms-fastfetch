// ci.jsonc - plain output for scripts and batch logs: no logo, no colours,
// failed or unsupported modules shown.  Use: fastfetch -c ci
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": { "type": "none" },
    "display": { "pipe": true, "showErrors": true },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "cluster",
        "packages",
        "shell",
        "terminal",
        "cpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "locale",
        "processes",
        "users",
        "datetime",
        "version"
    ]
}
