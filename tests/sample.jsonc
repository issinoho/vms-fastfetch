// An upstream-style fastfetch config used by tools/test.sh.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",          /* OpenVMS_small */
        "color": { "1": "green" },
        "padding": { "left": 2, "right": 3 },
    },
    "display": {
        "separator": " -> ",
        "color": { "keys": "magenta" },
        "key": { "width": 16 },
        "size": { "binaryPrefix": "si", "ndigits": 1 },
    },
    "general": { "multithreading": true },
    "modules": [
        "title",
        { "type": "separator", "string": "=-" },
        { "type": "os", "key": "System", "format": "{name} {version} on {arch}" },
        { "type": "memory", "keyColor": "yellow" },
        { "type": "custom", "format": "--- {#cyan}custom text{#} ---" },
        "gpu",
        "nosuchmodule",
        { "type": "uptime", "key": "Up" },
    ]
}
